# 运行期数据与密钥（绝不进仓库）
*.local.json
config.json
keys.local.json
*.bak

# 环境与构建产物
.venv/
app/_build_stamp.py
# 构建产物一律**只在根目录**，所以锚定：不锚定的话 `web/build/`、`scripts/dist/`
# 这类将来真要提交的源码目录会被静默忽略（比漏提交更难发现）。
/build/
/build_*/
/dist/
/dist_*/
__pycache__/
*.pyc
*.spec
.pytest_cache/
.pytest_probe/
.coverage
.coverage.*
# 覆盖率数据文件可以被环境变量改名（分批跑时常用），xdist 还会留下 .cov_x.pid* 分片。
# 只锚定 .cov_ 前缀：写成 `.cov*` 会把将来的 `.coveragerc` 一起吞掉。
/.cov_*
htmlcov/
# 测试用的固定 basetemp（本机受管环境里必须指定，见 AGENTS.md「容易踩的坑」）
# 用通配符：临时目录常被顺手起成 .pytest_tmp2 / .pytest_tmp3，漏网就会被 git add -A 吞进提交
.pytest_tmp*/

# 本地备份目录
_backup_*/

# pytest 指定 basetemp 时的落点（2026-09-28 用过 .basetemp 这个名字）
.basetemp/

# 交付目录 DELIVERY/ 里的**文档**是要入库的（历史上 4 份 .md/.html 都在版本库里），
# 但二进制与运行日志不入库：2026-10-17 的交付目录里有 38MB（两个 19MB 的 exe + 日志），
# 一次 `git add -A` 就会把它们吞进仓库 —— 而"18MB 产物不进版本库"是既有约定（dist/ 也是忽略的）。
DELIVERY/**/*.exe
DELIVERY/**/*.log

# 别的工具在本仓留下的临时评估件 + 探针结果转储：只属于"那一次会话"，
# 留着会让 `git status` 与本地门禁看着有不同的工作区状态（见 AGENTS.md 容易踩的坑）。
/.openclaw_eval_*
/mutation-probe-*.json


# 会话与文档查看器的临时缓存
.dumate/
.tmp/

# Python 打包产物（`pip wheel .` / `pip install .` 会在仓库根留下 egg-info，
# 2026-10-25 加 pyproject 时实测出现）—— 构建残渣，不入库
*.egg-info/
build/
dist/
