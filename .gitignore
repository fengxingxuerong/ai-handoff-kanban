# 运行期数据与密钥（绝不进仓库）
*.local.json
config.json
keys.local.json
*.bak

# 环境与构建产物
.venv/
app/_build_stamp.py
build/
build_*/
dist/
dist_*/
__pycache__/
*.pyc
*.spec
.pytest_cache/
.pytest_probe/
.coverage
.coverage.*
# 覆盖率数据文件可以被环境变量改名（分批跑时常用），xdist 还会留下 .cov_x.pid* 分片
.cov*
htmlcov/
# 测试用的固定 basetemp（本机受管环境里必须指定，见 AGENTS.md「容易踩的坑」）
# 用通配符：临时目录常被顺手起成 .pytest_tmp2 / .pytest_tmp3，漏网就会被 git add -A 吞进提交
.pytest_tmp*/

# 本地备份目录
_backup_*/
